# Ignore archives and generated data; track original CSVs for the private team repository.
/data/*
!/data/README.md
*.csv
*.tsv
*.parquet
*.arrow
*.jsonl
*.zip
*.tar
*.gz
!/data/raw/
/data/raw/*
!/data/raw/train.csv
!/data/raw/test.csv
!/data/raw/sample_submission.csv
/models/*
!/models/README.md
/submissions/*
!/submissions/README.md
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.safetensors

# Python, notebooks, and local environment
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.cache/
wandb/
mlruns/
.env
.env.*
!.env.example
kaggle.json
.DS_Store
